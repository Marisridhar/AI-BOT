PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ai_bot
# Also supported: MONGO_URI
MONGO_URI=mongodb://localhost:27017/ai_bot

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Administrator Security Header (x-admin-api-key)
ADMIN_API_KEY=your_admin_secret_key_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Student Portal URL
FRONTEND_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Email Delivery Configuration (Nodemailer SMTP)
# Supported variables: EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS, EMAIL_APP (fallback for EMAIL_USER), EMAIL_FROM, EMAIL_SECURE
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="AI Bot <your_email@gmail.com>"
EMAIL_SECURE=false

